# Backend Integrations (Optional)
# Fill in any or all of these providers to link external backend services.
# You can also configure them directly in the Admin Panel under Settings -> Linked Backend Services.

# 1. Custom Webhook (Zapier, Make, n8n, custom Node / Python / Go server, Slack, Discord webhook)
VITE_WEBHOOK_URL=

# 2. Formspree Form ID (direct email forwarding for inquiries)
VITE_FORMSPREE_ID=

# 3. Resend Transactional Email API Key & Recipient Email
VITE_RESEND_API_KEY=
VITE_RESEND_TO_EMAIL=hello@osbornefernandes.design

# 4. Telegram Bot Token & Chat ID for instant phone notifications
VITE_TELEGRAM_BOT_TOKEN=
VITE_TELEGRAM_CHAT_ID=
